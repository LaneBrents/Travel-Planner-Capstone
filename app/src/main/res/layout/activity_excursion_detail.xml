<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Screen Title -->
        <TextView
            android:id="@+id/textViewExcursionDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Excursion"
            android:textColor="@android:color/black"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- Excursion Information -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Excursion Information"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Excursion Title"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTextExcursionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter excursion title"
            android:inputType="text"
            android:singleLine="true"
            android:minHeight="48dp"
            android:textColor="@android:color/black"
            android:textColorHint="@android:color/darker_gray" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Excursion Date"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTextExcursionDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="MM/dd/yyyy"
            android:inputType="date"
            android:singleLine="true"
            android:minHeight="48dp"
            android:textColor="@android:color/black"
            android:textColorHint="@android:color/darker_gray" />

        <!-- Actions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Actions"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/buttonSaveExcursion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Excursion" />

        <Button
            android:id="@+id/buttonDeleteExcursion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Delete Excursion"
            android:contentDescription="Delete this excursion" />

    </LinearLayout>

</ScrollView>